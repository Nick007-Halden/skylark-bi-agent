# Copy to .env for local runs, or set as Streamlit Cloud "Secrets" for deployment.

MONDAY_API_TOKEN=your_monday_personal_api_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional defaults so you don't retype board IDs in the sidebar every time:
DEALS_BOARD_ID=
WORK_ORDERS_BOARD_ID=
